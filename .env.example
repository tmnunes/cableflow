# CableFlow — server-only env (never VITE_ prefix — those are exposed in the browser bundle)
# Use .env or .env.local in the project root for local dev.
# Set the same vars in Vercel → Project → Settings → Environment Variables for production.
# Project: https://jberponwqclwpipovgrf.supabase.co

SUPABASE_URL=https://jberponwqclwpipovgrf.supabase.co
# Supabase Dashboard → Settings → API → service_role (secret), NOT the anon/public key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: restrict API to known origins (comma-separated). Leave empty to allow all.
# ALLOWED_ORIGINS=https://cableflow-ruby.vercel.app,http://localhost:5173
